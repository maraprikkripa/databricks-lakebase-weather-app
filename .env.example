# Environment variables for local development
# Copy this to .env and fill in your actual values
# DO NOT commit .env to git!

# Lakebase connection URL (from Databricks Lakebase instance)
LAKEBASE_URL=postgresql://student:your_password@host.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# Flask configuration
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=8000
FLASK_ENV=development

# Table names (optional, defaults are fine)
WEATHER_DOCUMENTS_TABLE=weather_documents
WEATHER_EMBEDDINGS_TABLE=weather_embeddings

# Anthropic API key for RAG endpoint (optional)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...
